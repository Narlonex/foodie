# Copy to .env.local for local development. Never commit real credentials.

# Required. Neon pooled PostgreSQL connection string (or any PostgreSQL 14+ URL).
# Example shape only:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional. IANA timezone used to decide the current diary date.
APP_TIMEZONE=Europe/Bratislava

# Recommended. Open Food Facts asks clients to identify themselves.
# Use a real contact address, not a placeholder.
OFF_CONTACT_EMAIL=you@example.com

# Optional. Full custom User-Agent; overrides the generated value when set.
# OFF_USER_AGENT=Foodie/1.0 (you@example.com)

# Optional. Server-only USDA FoodData Central API key.
# When blank, Foodie uses USDA's public DEMO_KEY (low hourly limits) so USDA
# search works out of the box. Add a personal key for normal use.
USDA_FDC_API_KEY=

# Optional. Used only for the optional PostgreSQL integration tests.
# Use a dedicated test database, never production.
# FOODIE_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
